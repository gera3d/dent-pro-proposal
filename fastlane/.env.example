# App Store Connect API key auth (recommended)
ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=YOUR_ISSUER_ID

# Option A: Base64-encoded contents of AuthKey_XXXXXX.p8
ASC_KEY_CONTENT_BASE64=BASE64_P8_CONTENT

# Option B: Absolute path to AuthKey_XXXXXX.p8 (use this instead of ASC_KEY_CONTENT_BASE64)
# ASC_KEY_FILE=/absolute/path/to/AuthKey_XXXXXX.p8

# Optional defaults for lane inputs
# TESTFLIGHT_GROUPS=Internal,External
# TESTFLIGHT_WHAT_TO_TEST=Please validate damage capture, photo upload, PDF generation, and Airtable sync.
