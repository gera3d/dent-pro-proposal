<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dentexperts.warmup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/gerayeremin/Documents/Dent Pro/warmup/daily_warmup.py</string>
    </array>

    <!-- Run every day at 9:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/gerayeremin/Documents/Dent Pro/warmup/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/gerayeremin/Documents/Dent Pro/warmup/logs/launchd_stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/gerayeremin/Documents/Dent Pro/warmup</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
